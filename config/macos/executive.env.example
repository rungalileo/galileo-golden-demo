# Copy to a private file, replace the required values, then chmod 600.
# This file is data. The installer parses an allow-list and never sources it.

# Required for Hosted (OpenAI) chat and embeddings
OPENAI_API_KEY=
OPENAI_DEFAULT_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=768

# Required for Galileo logging, cloud links, and Agent Control
GALILEO_API_KEY=
GALILEO_CONSOLE_URL=https://console.demo-v2.galileocloud.io/
GALILEO_DOMAIN=healthcare
GALILEO_PROJECT=
GALILEO_PROJECT_ID=
GALILEO_PROJECT_URL=
GALILEO_LOG_STREAM=
GALILEO_LOG_STREAM_ID=
GALILEO_LOG_STREAM_URL=
# These are derived from GALILEO_CONSOLE_URL when empty.
GALILEO_API_URL=
AGENT_CONTROL_URL=
AGENT_CONTROL_AGENT_NAME=golden-demo-agent
AGENT_CONTROL_RUNTIME_AUTH_MODE=jwt
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
AGENT_CONTROL_TARGET_TYPE=log_stream

# Optional. A strong PostgreSQL password and Open WebUI session key are generated
# when omitted. Set them only when migrating an existing installation.
POSTGRES_PASSWORD=
OPEN_WEBUI_SECRET_KEY=
ADMIN_KEY=
