# 1Password `op inject` template. Adjust item and field names to match the Cisco
# vault, while keeping the keys on the left unchanged.

OPENAI_API_KEY="{{ op://Cisco Starter Kit/Galileo Golden Demo/OpenAI API Key }}"
OPENAI_DEFAULT_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=768

GALILEO_API_KEY="{{ op://Cisco Starter Kit/Galileo Golden Demo/Galileo API Key }}"
GALILEO_CONSOLE_URL=https://console.demo-v2.galileocloud.io/
GALILEO_API_URL=
AGENT_CONTROL_URL=
AGENT_CONTROL_AGENT_NAME=golden-demo-agent
AGENT_CONTROL_RUNTIME_AUTH_MODE=jwt
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
AGENT_CONTROL_TARGET_TYPE=log_stream

# Optional fields may be removed if they do not exist in 1Password.
POSTGRES_PASSWORD="{{ op://Cisco Starter Kit/Galileo Golden Demo/Postgres Password }}"
OPEN_WEBUI_SECRET_KEY="{{ op://Cisco Starter Kit/Galileo Golden Demo/Open WebUI Secret Key }}"
ADMIN_KEY="{{ op://Cisco Starter Kit/Galileo Golden Demo/Admin Key }}"
